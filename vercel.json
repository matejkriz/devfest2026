{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" }
      ]
    },
    {
      "source": "/downloads/your-app-their-data.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Matej-Kriz-DevFest-2026-Your-app-their-data.pdf\"" }
      ]
    }
  ]
}
